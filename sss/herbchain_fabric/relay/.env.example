# Shared secret the relay checks on every incoming webhook request (set the
# same value in Supabase Dashboard → Database → Webhooks → HTTP Headers, as
# e.g. `x-webhook-secret: <this value>`). Without this, anyone who finds the
# relay's URL could forge fake blockchain-confirmed writes.
WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-value

# Supabase — service-role key, NEVER the anon key. This is what lets the
# relay write blockchain_tx_id/blockchain_status back without needing a new
# RLS policy. Server-side only — never put this in herbchain_web/.env or
# ship it to any frontend/mobile bundle.
SUPABASE_URL=https://rcsayomijvykveqvarsq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Fabric Gateway connection — this relay submits transactions as CollectionOrg
# by default (a PoC simplification; a production version would hold a
# separate identity per org and pick one based on which org the event
# belongs to). Paths are relative to herbchain_fabric/network/crypto-config
# after running network/scripts/generate-crypto.sh.
FABRIC_CHANNEL_NAME=ayurtrace-channel
FABRIC_CHAINCODE_NAME=ayurtrace-chaincode
FABRIC_MSP_ID=CollectionOrgMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.collection.ayurtrace.com
FABRIC_TLS_CERT_PATH=../network/crypto-config/peerOrganizations/collection.ayurtrace.com/peers/peer0.collection.ayurtrace.com/tls/ca.crt
FABRIC_CERT_PATH=../network/crypto-config/peerOrganizations/collection.ayurtrace.com/users/Admin@collection.ayurtrace.com/msp/signcerts/Admin@collection.ayurtrace.com-cert.pem
FABRIC_KEY_DIR_PATH=../network/crypto-config/peerOrganizations/collection.ayurtrace.com/users/Admin@collection.ayurtrace.com/msp/keystore

PORT=4400
